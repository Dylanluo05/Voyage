PORT=4000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@voyage.yabqkcs.mongodb.net/?appName=Voyage
# Must be at least 32 characters — generate with `openssl rand -hex 32`
JWT_SECRET=long_JWT_secret_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
RESEND_API_KEY=your_resend_api_key_here
# Update once a sending domain is verified with Resend (the sandbox default
# below can only deliver to your own Resend account email)
MAIL_FROM=Voyage <onboarding@resend.dev>
# Set to true only once MAIL_FROM is on a verified Resend domain — until
# then, OTP emails can't reach real users and this must stay false
REQUIRE_EMAIL_OTP=false
